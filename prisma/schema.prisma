generator client {
    provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String   @db.Text
  consent     Boolean  @default(false)
  consentAt   DateTime?
  formType    String   @default("contacto")
  status      String   @default("novo")
  createdAt   DateTime @default(now())
  replies     ContactReply[]
  attachments ContactAttachment[]
}

model ContactAttachment {
  id           String @id
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([submissionId])
}

model ContactReply {
  id           String @id
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  message      String @db.Text
  status       String @default("a enviar")
  createdAt    DateTime @default(now())

  @@index([submissionId])
}

model SmtpSettings {
  id                 String   @id @default("default")
  host               String   @default("smtp.gmail.com")
  port               Int      @default(465)
  username           String
  passwordCiphertext String   @db.Text
  recipient          String
  enabled            Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}
